# Ver docs/frontend-arquitectura.md, sección 5.2 y 5.4.
# Nombre de servicio interno de Docker — NUNCA la URL pública del backend,
# incluso mientras el backend siga expuesto públicamente durante la transición.
BACKEND_URL=http://app:8080

# Usado para firmar/cifrar las cookies httpOnly de sesión (access + refresh token).
# Generar con: openssl rand -base64 32
COOKIE_SECRET=

# Nombre de la cookie de sesión que valida middleware.ts (solo verifica
# presencia, no validez — la validez la resuelve el backend en cada request).
#SESSION_COOKIE_NAME=fractall_session
